# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Shared secret between the Next.js server (BACKEND_TOKEN on Vercel) and this API.
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QUAKENET_TOKEN=

# Optional settings (defaults shown).
# QUAKENET_REGION=local
# QUAKENET_JOBS_DIR=var/jobs
# QUAKENET_QAOA_RESTARTS=2
# QUAKENET_QAOA_MAXITER=250
# QUAKENET_VAR_DIR=var                 agent state: settings.json, memory/, sequences/, feed_state.json
# QUAKENET_AGENT_RESTARTS=4            agent plan: random COBYLA starts on a cold start (1 to 8)
# QUAKENET_AGENT_MAXITER=250           agent plan: COBYLA steps per start (1 to 1000)
# QUAKENET_AGENT_LOC_EVENTS=100        agent plan: aftershocks used for the location-error estimates
# QUAKENET_FEED_POLL_S=60              scheduler period in seconds (live checks and the feed watcher)
# QUAKENET_OFFLINE=1                   never touch the network; use cached data only

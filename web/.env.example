# Copy to .env.local (git-ignored) and fill in. Placeholder values only in this file.
# These are server-side secrets. Never prefix them with NEXT_PUBLIC_.

# Origin of the Python API (the tunnel address, or http://127.0.0.1:8000 locally).
# No trailing path: the console appends /api/v1 itself.
# Must be https, except for a backend on this machine (localhost / 127.0.0.1).
BACKEND_URL=https://your-laptop.example.ts.net

# Shared secret sent as "Authorization: Bearer ..." to the Python API.
BACKEND_TOKEN=replace-with-the-shared-secret

# Team passcode required to start a quantum run. Leave empty to disable starting runs.
RUN_PASSCODE=replace-with-a-team-passcode
